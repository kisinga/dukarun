# Deploy target config — copy to .env.deploy (gitignored) and fill in.
# Sourced by scripts/deploy-db.sh and scripts/deploy-apps.sh.

# SSH target for the Coolify host, e.g. root@your-server-ip
DEPLOY_SSH_HOST=

# The supabase service dir on the host:
# /data/coolify/services/<your-service-uuid>
COOLIFY_SERVICE_DIR=

# Canonical public site used by storefront and statement legal links.
SITE_PUBLIC_URL=https://dukarun.com
APP_PUBLIC_URL=https://app.dukarun.com
# Also synchronized into Supabase Database Vault by scripts/deploy-db.sh so
# database-generated receipt and invoice links use the same storefront origin.
STOREFRONT_PUBLIC_URL=https://store.dukarun.com

# Cron calls this after blog publication to rebuild static SEO pages. Configure
# COOLIFY_API_URL, COOLIFY_API_TOKEN, and COOLIFY_SITE_UUID on Edge Runtime too.
SITE_DEPLOY_URL=https://supa.dukarun.com/functions/v1/site-deploy

# Database cron calls this with the service-role bearer token.
MPESA_PROCESS_URL=https://supa.dukarun.com/functions/v1/mpesa-process
