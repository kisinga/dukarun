# Deploy target config — copy to .env.deploy (gitignored) and fill in.
# Sourced by scripts/deploy-db.sh and scripts/deploy-apps.sh.

# SSH target for the Coolify host, e.g. root@your-server-ip
DEPLOY_SSH_HOST=

# The supabase service dir on the host:
# /data/coolify/services/<your-service-uuid>
COOLIFY_SERVICE_DIR=
