# Supabase stack secrets — pilot/rewrite (branch: pilot/supabase)
# Set edge-function secrets with:  npx supabase secrets set NAME=value
# Local dev overrides go in supabase/.env (git-ignored).

# --- SMS (OTP + notifications). SMS_PROVIDER: textsms | africastalking ---
SMS_PROVIDER=textsms
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENVIRONMENT=sandbox

# --- WhatsApp (self-hosted OpenWA gateway; notifications only) ---
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION=default

# --- Paystack (platform subscription billing) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Email (HTTPS API only — SMTP ports are blocked on Edge Functions) ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Platform ops ---
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=
SUBSCRIPTION_TRIAL_DAYS=30

# --- Frontend apps (Cloudflare Pages env vars) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
