# Active Supabase system
# Copy to .env for local scripts. Angular production builds read the two public
# values below through scripts/generate-environment.mjs.

# Public browser configuration (safe to expose in compiled frontend bundles)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SITE_PUBLIC_URL=https://dukarun.com
APP_PUBLIC_URL=https://app.dukarun.com
STOREFRONT_PUBLIC_URL=https://store.dukarun.com
# Optional local directory URL for testing rendered marketing videos. Not deployed.
MARKETING_VIDEO_BASE_URL=
# Web-only learning integrations. USERTOUR_TOKEN is the public SDK environment token.
GITBOOK_SITE_URL=https://dukarun.gitbook.io/dukarun-docs
USERTOUR_TOKEN=
USERTOUR_CONTENT_IDS_JSON={}

# Database automation / CI (never expose these in a frontend bundle)
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vendure -> Supabase migration source. Required only by scripts/etl/*.
SOURCE_DB_URL=postgresql://vendure:vendure@127.0.0.1:5432/vendure
TARGET_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
VENDURE_ASSET_DIR=archive/vendure/backend/static/assets

# Edge Function provider secrets. Configure production values in the Supabase
# deployment, not in Cloudflare Pages.
SMS_PROVIDER=textsms
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION=default
# Also create this value in Supabase Vault (no trailing slash).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
MPESA_CALLBACK_BASE_URL=https://project-ref.supabase.co/functions/v1
EMAIL_API_KEY=
EMAIL_FROM=
# Server-only Usertour identity verification secret.
USERTOUR_SIGNING_SECRET=

# Public-site rebuild dispatcher (Edge Runtime only; never frontend build args).
COOLIFY_API_URL=https://coolify.example.com
COOLIFY_API_TOKEN=
COOLIFY_SITE_UUID=
