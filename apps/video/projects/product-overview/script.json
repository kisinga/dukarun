  "callToAction": "Get started",
  "narration": [
    {
      "id": "business-day",
      "text": "Running a business means keeping track of sales, stock, cash, suppliers, staff, customer credit, and more.",
      "source": "script",
      "audioFile": null,
      "startFrame": 0,
      "endFrame": 251
    },
    {
      "id": "breakdown",
      "text": "When any of these parts breaks down, the business suffers. Uncollected credit, stockouts, and uncertain margins cost money.",
      "source": "script",
      "audioFile": null,
      "startFrame": 251,
      "endFrame": 521
    },
    {
      "id": "transition",
      "text": "Dukarun keeps sales, stock, credit, and costs in one place.",
      "source": "script",
      "audioFile": null,
      "startFrame": 521,
      "endFrame": 711
    },
    {
      "id": "sell",
      "text": "Record each sale in seconds. Find the item, take cash or M-Pesa, and the record is complete.",
      "source": "script",
      "audioFile": null,
      "startFrame": 711,
      "endFrame": 931
    },
    {
      "id": "flow",
      "text": "Each sale updates stock and the books. If the connection drops, the record is saved and syncs when the internet returns.",
      "source": "script",
      "audioFile": null,
      "startFrame": 931,
      "endFrame": 1163
    },
    {
      "id": "owner",
      "text": "See your margin, what is selling, and what needs restocking before shelves run empty. Compare every location and act on numbers you can trust.",
      "source": "script",
      "audioFile": null,
      "startFrame": 1163,
      "endFrame": 1488
    },
    {
      "id": "credit",
      "text": "See what customers owe you and what you owe suppliers. Keep payments against the right balance, and send customer receipts and reminders through SMS or WhatsApp.",
      "source": "script",
      "audioFile": null,
      "startFrame": 1488,
      "endFrame": 1848
    },
    {
      "id": "team",
      "text": "See sales and collections by team member, then prepare commissions from the same records.",
      "source": "script",
      "audioFile": null,
      "startFrame": 1848,
      "endFrame": 2037
    },
    {
      "id": "operations",
      "text": "Approvals and permissions protect sensitive actions. The audit trail shows who did what. Purchases, expenses, stock movements, and reports stay connected.",
      "source": "script",
      "audioFile": null,
      "startFrame": 2037,
      "endFrame": 2387
    },
    {
      "id": "close",
      "text": "Clear balances. Fewer stock surprises. Numbers you can trust. Run your business with Dukarun.",
      "source": "script",
      "audioFile": null,
      "startFrame": 2387,
      "endFrame": 2645
    }
  ],
