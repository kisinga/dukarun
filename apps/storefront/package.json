{
  "name": "@dukarun/storefront",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ../../scripts/generate-environment.mjs storefront && node ../../scripts/generate-storefront-sitemap.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:unit": "vitest run --root ../.. --config vitest.unit.config.ts apps/storefront/src",
    "test:component": "ng run storefront:test-component"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@ng-icons/core": "^33.3.0",
    "@ng-icons/heroicons": "^33.3.0",
    "@supabase/supabase-js": "^2.76.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.5.14",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.4",
    "@rolldown/binding-linux-x64-musl": "^1.0.0-rc.4",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.1",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.1",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0",
    "napi": "*"
  }
}
